# BURUSEEEE Birthday Scrapbook - Supabase & Vercel Environment Configuration
# Never expose the Supabase service-role secret key! Only use the anon public key here.

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (safe to include in frontend apps)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Admin Security PIN (Unlock upload, edit and delete controls)
# Default is 2608 (representing the iconic 26.08.2016 bestie anniversary)
VITE_ADMIN_PIN=2608

# 4. Storage Bucket Name (Default: birthday-media)
VITE_SUPABASE_BUCKET=birthday-media
